-export type ModelAuthDeps = {
-  /** トークンを確かめ、その人の id を返す。確かめられなければ null。 */
-  verify: (token: string) => Promise<string | null>;
-  /** その人が管理者か。 */
-  isAdmin: (token: string, userId: string) => Promise<boolean>;
