+      cancelUrl: "https://x/no",
+      trialDays: 7,
+      lang: "zh-TW",
+      interval: "year",
+    });
+    expect(f.get("locale")).toBe("zh-TW");
+    expect(f.get("custom_text[submit][message]")).toContain("7 天免費期");
+    expect(submitMessage("ja", "month", 0)).toContain("毎月自動で料金");
+    for (const lang of ["ja", "en", "zh-TW"] as const)
