+  });
+
+  it("3言語とも文がある", () => {
+    for (const key of Object.keys(DICT).filter((k) => k.startsWith("checkout.")))
+      for (const lang of ["ja", "en", "zh-TW"] as const)
+        expect([key, lang, Boolean(DICT[key][lang])]).toEqual([key, lang, true]);
