       - ".github/workflows/android-apk.yml"
 
 jobs:
@@ -43,13 +48,13 @@ jobs:
           cache: npm
 
       # Android のビルドには Java が要る。
-      - uses: actions/setup-java@v4
+      - uses: actions/setup-java@v5
         with:
           distribution: temurin
           java-version: "21"
 
       - name: 依存パッケージを入れる
-        run: npm ci
+        run: npm ci --no-audit --no-fund
 
       - name: Webアプリをビルドする
         run: npm run build
@@ -70,3 +75,40 @@ jobs:
           name: catchwords-debug-apk
           path: android/app/build/outputs/apk/debug/*.apk
           if-no-files-found: error
+
+      # ── ストア提出用（署名付き AAB）──────────────────────────────
+      # 秘密（Settings → Secrets → Actions）が4つそろっている時だけ作る:
+      #   ANDROID_KEYSTORE_BASE64 … アップロード鍵（.jks）を base64 にした文字列
+      #   ANDROID_KEYSTORE_PASSWORD / ANDROID_KEY_ALIAS / ANDROID_KEY_PASSWORD
+      # versionCode は実行番号を使う（Play は同じ番号を二度受け付けない）。
+      - name: 署名鍵を置く
+        id: keystore
+        env:
+          KS_B64: ${{ secrets.ANDROID_KEYSTORE_BASE64 }}
+        run: |
+          if [ -z "$KS_B64" ]; then
+            echo "署名鍵の秘密が無いので AAB は作らない（APK だけ）"
+            echo "ready=false" >> "$GITHUB_OUTPUT"
+          else
+            echo "$KS_B64" | base64 -d > "$RUNNER_TEMP/upload.jks"
+            echo "ready=true" >> "$GITHUB_OUTPUT"
+          fi
+
+      - name: 署名付き AAB を作る
+        if: steps.keystore.outputs.ready == 'true'
+        working-directory: android
+        env:
+          CW_KEYSTORE_FILE: ${{ runner.temp }}/upload.jks
+          CW_KEYSTORE_PASSWORD: ${{ secrets.ANDROID_KEYSTORE_PASSWORD }}
+          CW_KEY_ALIAS: ${{ secrets.ANDROID_KEY_ALIAS }}
+          CW_KEY_PASSWORD: ${{ secrets.ANDROID_KEY_PASSWORD }}
+          CW_VERSION_CODE: ${{ github.run_number }}
+        run: ./gradlew bundleRelease --no-daemon
+
+      - name: AAB を成果物として上げる
+        if: steps.keystore.outputs.ready == 'true'
+        uses: actions/upload-artifact@v4
+        with:
+          name: catchwords-release-aab
+          path: android/app/build/outputs/bundle/release/*.aab
+          if-no-files-found: error
