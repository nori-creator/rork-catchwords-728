+    expect(String(err.message)).toContain("AI_CONSENT_CHECK_FAILED");
+    expect(statusForError(err)).toBe(503);
+  });
+});
+
+describe("recordAiConsentFor（同意する・取り消す）", () => {
+  it("同意で行を足し、取り消しで revoked_at を入れる。取り消した後は断る", async () => {
+    const { db, calls } = fakeDb();
