+
+/** 辞書の日本語で引く（`{n}` などは埋める）。 */
+const t = (key: string, vars: Record<string, string | number> = {}) =>
+  (DICT[key]?.ja ?? key).replace(/\{(\w+)\}/g, (m, k) => (k in vars ? String(vars[k]) : m));
+
