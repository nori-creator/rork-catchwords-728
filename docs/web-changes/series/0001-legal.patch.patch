+        <OperatorDetails info={info} lang={lang} />
+        <h2>{x.faq}</h2>
+        <dl>
+          {x.items.map(([q, a]) => (
+            <div key={q} className="mt-3">
+              <dt className="font-semibold">{q}</dt>
+              <dd>{a}</dd>
+            </div>
+          ))}
+        </dl>
+      </section>
+    </>
+  );
+}
