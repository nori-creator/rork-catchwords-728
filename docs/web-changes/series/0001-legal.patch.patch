+export function SupportDocument({ info, lang }: { info: LegalPublicInfo; lang: UiLang }) {
+  const x = TX[lang];
+  return (
+    <>
+      <h1 className="mt-4 text-hero font-bold tracking-tight">{x.title}</h1>
+      <section className="legal-doc mt-6">
+        <p>{x.intro}</p>
